<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ShopList</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="manifest" href="/manifest.json?v=<%= locals.version %>">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icon.svg">
  <meta name="theme-color" content="#3b82f6">
</head>
<body class="bg-gray-50 min-h-dvh">
  <div class="max-w-sm mx-auto px-4 py-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">ShopList</h1>
        <p class="text-gray-400 text-sm truncate max-w-48">Bonjour, <%= user.pseudo %></p>
      </div>
      <form action="/logout" method="POST">
        <button type="submit"
          class="text-sm text-gray-500 hover:text-gray-700 px-3 py-1.5 border border-gray-200 rounded-xl transition-colors">
          Déconnexion
        </button>
      </form>
    </div>

    <% if (recentItems && recentItems.length > 0) { %>
      <div class="mb-6">
        <h2 class="text-base font-semibold text-gray-700 mb-3">Ajouts recents</h2>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 divide-y divide-gray-100">
          <% recentItems.forEach(item => { %>
            <a href="/list/<%= item.list_id %>" class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-800 truncate"><%= item.name %><% if (item.quantity > 1) { %> <span class="text-xs text-gray-400">x<%= item.quantity %></span><% } %></p>
                <p class="text-xs text-gray-400 truncate"><%= item.added_by %> dans <%= item.list_name %></p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (lists.length > 0) { %>
      <div class="mb-6">
        <h2 class="text-base font-semibold text-gray-700 mb-3">Mes listes</h2>
        <div class="space-y-2">
          <% lists.forEach(list => { %>
            <a href="/list/<%= list.id %>"
              class="flex items-center bg-white rounded-xl shadow-sm border border-gray-100 p-4 hover:border-blue-200 transition-colors">
              <div class="flex-1 min-w-0">
                <p class="font-medium text-gray-800 text-sm truncate"><%= list.name %></p>
                <p class="text-xs text-gray-400 mt-1"><%= list.item_count %> article(s)</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-base font-semibold text-gray-700 mb-4">Créer une nouvelle liste</h2>
      <form action="/lists" method="POST">
        <input type="text" name="name" placeholder="Ex: Courses de la semaine" required
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        <button type="submit"
          class="w-full bg-blue-500 text-white font-medium py-3 rounded-xl text-sm hover:bg-blue-600 active:bg-blue-700 transition-colors">
          Créer la liste
        </button>
      </form>
    </div>
  </div>
  <div id="installBanner" style="display:none" class="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 px-4 py-2 shadow-lg flex items-center justify-center">
    <div class="max-w-sm w-full flex items-center gap-2">
      <img src="/icon.svg" alt="" width="32" height="32" class="w-8 h-8 rounded-lg shrink-0">
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-gray-800 leading-tight">ShopList</p>
        <p id="bannerSub" class="text-xs text-gray-400 leading-tight">Installer l'application</p>
      </div>
      <button id="installBtn" class="bg-blue-500 text-white px-3 py-1.5 rounded-xl text-xs font-medium transition-colors shrink-0">Installer</button>
      <button id="installClose" class="text-gray-400 p-1 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
  <script>
    (function() {
      if (window.matchMedia('(display-mode: standalone)').matches) return;
      if (localStorage.getItem('installBannerDismissed')) return;
      var banner = document.getElementById('installBanner');
      var sub = document.getElementById('bannerSub');
      var deferredPrompt;
      function show() { banner.style.display = 'flex'; }
      function hide() { banner.style.display = 'none'; localStorage.setItem('installBannerDismissed', '1'); }
      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault();
        deferredPrompt = e;
        show();
      });
      document.getElementById('installBtn').onclick = function() {
        if (deferredPrompt) { deferredPrompt.prompt(); deferredPrompt.userChoice.then(function() { deferredPrompt = null; }); }
        hide();
      };
      document.getElementById('installClose').onclick = hide;
      var ua = navigator.userAgent;
      if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
        sub.textContent = 'Dans Safari: Partager > "Ajouter a l\'ecran d\'accueil"';
        show();
      }
    })();
  </script>
  <p class="text-center text-xs text-gray-300 mt-8">v<%= locals.version %></p>
  <script src="/js/app-version.js?v=<%= locals.version %>" defer></script>
</body>
</html>
