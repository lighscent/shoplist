<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= list.name %> - ShopList</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="manifest" href="/manifest.json?v=<%= locals.version %>">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icon.svg">
  <meta name="theme-color" content="#3b82f6">
</head>
<body class="bg-gray-50 min-h-dvh">
  <div class="max-w-sm mx-auto px-4 py-6">
    <div class="flex items-start justify-between mb-6">
      <div class="min-w-0 flex-1 flex items-center gap-3">
        <a href="/" class="shrink-0 text-gray-400 hover:text-gray-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div class="min-w-0">
          <h1 class="text-2xl font-bold text-gray-800 truncate"><%= list.name %></h1>
          <p class="text-xs text-gray-400 mt-1" id="updatedDate">
          <% 
            const d = new Date(list.updated_at + 'Z');
            const pad = n => String(n).padStart(2, '0');
            const formatted = pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear() + ' à ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
          %>
          Modifiée le <%= formatted %>
        </p>
      </div>
    </div>
      <a href="/list/<%= list.id %>/members"
        class="shrink-0 text-gray-400 hover:text-gray-600 transition-colors p-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </a>
    </div>

    <form id="addForm" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-6">
      <div class="flex gap-2 mb-3">
        <input type="number" name="quantity" min="1" value="1"
          class="w-16 px-3 py-2.5 border border-gray-200 rounded-xl text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shrink-0">
        <input type="text" name="name" placeholder="Nom de l'article" required
          class="flex-1 px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      </div>
      <button type="submit"
        class="w-full bg-blue-500 text-white font-medium py-2.5 rounded-xl text-sm hover:bg-blue-600 active:bg-blue-700 transition-colors">
        Ajouter
      </button>
    </form>

    <div id="itemsList" class="space-y-2">
      <% if (list.items.length === 0) { %>
        <p class="text-center text-gray-400 py-12 text-sm">Aucun article. Ajoutez-en un !</p>
      <% } %>
      <% list.items.forEach(item => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-3 flex items-center gap-2 transition-opacity <%= item.checked ? 'opacity-50' : '' %>" data-id="<%= item.id %>">
          <input type="checkbox" <%= item.checked ? 'checked' : '' %>
            onchange="toggleItem('<%= item.id %>')"
            class="w-5 h-5 rounded border-gray-300 text-blue-500 focus:ring-blue-500 shrink-0">
          <div class="flex-1 min-w-0">
            <p class="<%= item.checked ? 'line-through text-gray-400' : 'text-gray-800' %> font-medium text-sm truncate">
              <%= item.name %>
            </p>
            <p class="text-xs text-gray-400 mt-0.5">
              <%= item.addedBy %>
            </p>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button onclick="changeQty('<%= item.id %>', -1)"
              class="w-7 h-7 rounded-full bg-red-100 text-red-500 hover:bg-red-200 flex items-center justify-center text-sm font-bold transition-colors">−</button>
            <span class="item-qty w-6 text-center text-sm font-medium text-gray-700"><%= item.quantity %></span>
            <button onclick="changeQty('<%= item.id %>', 1)"
              class="w-7 h-7 rounded-full bg-green-100 text-green-500 hover:bg-green-200 flex items-center justify-center text-sm font-bold transition-colors">+</button>
            <button onclick="deleteItem('<%= item.id %>')"
              class="text-red-300 hover:text-red-500 transition-colors p-1 ml-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      <% }) %>
    </div>
    <% if (locals.user && list.created_by === user.email) { %>
      <div class="mt-8 pt-6 border-t border-gray-200">
        <button onclick="deleteList()"
          class="w-full text-red-400 hover:text-red-600 text-sm font-medium py-2.5 rounded-xl border border-red-200 hover:border-red-300 transition-colors">
          Supprimer cette liste
        </button>
      </div>
    <% } %>

  </div>

  <div id="toast" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-gray-800 text-white px-4 py-3 rounded-xl text-sm shadow-lg max-w-xs text-center"></div>

  <div id="confirmOverlay" class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center px-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-xs p-6">
      <p id="confirmMsg" class="text-gray-800 text-sm font-medium text-center mb-5"></p>
      <div class="flex gap-3">
        <button id="confirmNo" class="flex-1 py-2.5 rounded-xl text-sm font-medium border border-gray-200 text-gray-500 hover:bg-gray-50 transition-colors">Annuler</button>
        <button id="confirmYes" class="flex-1 py-2.5 rounded-xl text-sm font-medium bg-red-500 text-white hover:bg-red-600 transition-colors">Confirmer</button>
      </div>
    </div>
  </div>

  <script>
    const listId = '<%= list.id %>';
    const userPseudo = '<%= locals.user && user.pseudo ? user.pseudo.replace(/'/g, "\\'") : "" %>';
    const defaultName = userPseudo || 'Anonyme';
    const ws = new WebSocket((window.location.protocol === 'https:' ? 'wss:' : 'ws:') + '//' + window.location.host);
    ws.onopen = () => ws.send(JSON.stringify({ action: 'join', listId }));
    ws.onmessage = (e) => { try { const d = JSON.parse(e.data); if (d.type === 'update') refreshList(); if (d.type === 'item-added' && d.item && d.item.addedBy !== defaultName) { showToast(d.item.addedBy + ' a ajoute ' + d.item.name); refreshList(); } } catch {} };
    function fmtDate(iso) {
      const d = new Date(iso + 'Z');
      const pad = n => String(n).padStart(2, '0');
      return pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear() + ' à ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    document.getElementById('addForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = this.querySelector('[name="name"]').value.trim();
      const qty = parseInt(this.querySelector('[name="quantity"]').value, 10) || 1;
      if (!name) return;
      await fetch('/api/list/' + listId + '/items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, quantity: qty, addedBy: defaultName })
      });

      this.querySelector('[name="name"]').value = '';
      this.querySelector('[name="quantity"]').value = '1';
      refreshList();
    });

    async function toggleItem(itemId) {
      await fetch('/api/list/' + listId + '/items/' + itemId + '/toggle', { method: 'POST' });
      refreshList();
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 3000);
    }

    function showConfirm(msg) {
      return new Promise(resolve => {
        document.getElementById('confirmMsg').textContent = msg;
        document.getElementById('confirmOverlay').classList.remove('hidden');
        document.getElementById('confirmYes').onclick = () => { document.getElementById('confirmOverlay').classList.add('hidden'); resolve(true); };
        document.getElementById('confirmNo').onclick = () => { document.getElementById('confirmOverlay').classList.add('hidden'); resolve(false); };
      });
    }

    async function deleteItem(itemId) {
      const ok = await showConfirm('Supprimer cet article ?');
      if (!ok) return;
      await fetch('/api/list/' + listId + '/items/' + itemId, { method: 'DELETE' });
      refreshList();
    }

    async function changeQty(itemId, delta) {
      if (delta === -1) {
        const itemDiv = document.querySelector(`[data-id="${itemId}"]`);
        const currentQty = parseInt(itemDiv?.querySelector('.item-qty')?.textContent, 10);
        if (currentQty <= 1) {
          const ok = await showConfirm('Supprimer cet article ?');
          if (!ok) return;
          await fetch('/api/list/' + listId + '/items/' + itemId, { method: 'DELETE' });
          refreshList();
          return;
        }
      }
      await fetch('/api/list/' + listId + '/items/' + itemId + '/quantity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ delta })
      });
      refreshList();
    }

    async function refreshList() {
      const res = await fetch('/api/list/' + listId);
      const data = await res.json();
      renderItems(data.items);
      document.getElementById('updatedDate').textContent = 'Modifiée le ' + fmtDate(data.updated_at);
    }

    function renderItems(items) {
      const container = document.getElementById('itemsList');
      if (items.length === 0) {
        container.innerHTML = '<p class="text-center text-gray-400 py-12 text-sm">Aucun article. Ajoutez-en un !</p>';
        return;
      }
      container.innerHTML = items.map(item => `
        <div data-id="${item.id}" class="bg-white rounded-xl shadow-sm border border-gray-100 p-3 flex items-center gap-2 transition-opacity ${item.checked ? 'opacity-50' : ''}">
          <input type="checkbox" ${item.checked ? 'checked' : ''}
            onchange="toggleItem('${item.id}')"
            class="w-5 h-5 rounded border-gray-300 text-blue-500 focus:ring-blue-500 shrink-0">
          <div class="flex-1 min-w-0">
            <p class="${item.checked ? 'line-through text-gray-400' : 'text-gray-800'} font-medium text-sm truncate">${esc(item.name)}</p>
            <p class="text-xs text-gray-400 mt-0.5">${esc(item.addedBy)}</p>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button onclick="changeQty('${item.id}', -1)"
              class="w-7 h-7 rounded-full bg-red-100 text-red-500 hover:bg-red-200 flex items-center justify-center text-sm font-bold transition-colors">−</button>
            <span class="item-qty w-6 text-center text-sm font-medium text-gray-700">${item.quantity}</span>
            <button onclick="changeQty('${item.id}', 1)"
              class="w-7 h-7 rounded-full bg-green-100 text-green-500 hover:bg-green-200 flex items-center justify-center text-sm font-bold transition-colors">+</button>
            <button onclick="deleteItem('${item.id}')"
              class="text-red-300 hover:text-red-500 transition-colors p-1 ml-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      `).join('');
    }

    function esc(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    async function deleteList() {
      const ok = await showConfirm('Supprimer cette liste definitivement ?');
      if (!ok) return;
      await fetch('/api/list/' + listId, { method: 'DELETE' });
      window.location.href = '/';
    }

    setInterval(refreshList, 30000);
  </script>
  <p class="text-center text-xs text-gray-300 mt-8 pb-4">v<%= locals.version %></p>
  <script src="/js/app-version.js?v=<%= locals.version %>" defer></script>
</body>
</html>
