<div id="installBanner" style="display:none;position:fixed;left:12px;right:12px;bottom:12px;z-index:50;max-width:28rem;margin:0 auto;background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.15);padding:12px 14px;">
  <div class="flex items-center gap-2">
    <img src="/icon-192.png" alt="" width="36" height="36" class="rounded-lg shrink-0" style="width:36px;height:36px;">
    <div class="flex-1 min-w-0">
      <p class="text-sm font-medium text-gray-800 leading-tight">Installer ShopList ?</p>
      <p id="bannerSub" class="text-xs text-gray-400 leading-tight">Accès direct depuis ton écran d'accueil</p>
    </div>
    <button id="installBtn" class="bg-blue-500 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors shrink-0">Installer</button>
    <button id="installClose" class="text-gray-400 p-1 shrink-0" aria-label="Fermer">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
  <div id="installSteps" class="hidden text-xs text-gray-600 mt-2" style="line-height:1.5;"></div>
</div>
<script>
(function() {
  if (window.matchMedia('(display-mode: standalone)').matches) return;
  var KEY = 'installBannerDismissedAt';
  try {
    var ts = parseInt(localStorage.getItem(KEY) || '0', 10);
    if (Date.now() - ts < 7 * 24 * 3600 * 1000) return;
  } catch (e) {}
  var banner = document.getElementById('installBanner');
  var sub = document.getElementById('bannerSub');
  var installBtn = document.getElementById('installBtn');
  var steps = document.getElementById('installSteps');
  if (!banner) return;
  var deferredPrompt = null;
  function hide() { banner.style.display = 'none'; }
  function dismiss() { hide(); try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {} }
  function manualSteps() {
    var ua = navigator.userAgent;
    if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) return 'Dans Safari : bouton Partager > « Ajouter à l\u2019écran d\u2019accueil »';
    if (/Android/i.test(ua)) return 'Menu \u22EE du navigateur > « Installer l\u2019application »';
    return 'Menu \u22EE du navigateur > « Installer ShopList\u2026 » (ou icône d\u2019installation dans la barre d\u2019adresse)';
  }
  window.addEventListener('beforeinstallprompt', function(e) {
    // Pas de preventDefault : on laisse Chrome afficher son UI native,
    // on garde l'événement pour notre bouton Installer.
    deferredPrompt = e;
    steps.classList.add('hidden');
    installBtn.textContent = 'Installer';
  });
  window.addEventListener('appinstalled', dismiss);
  installBtn.onclick = async function() {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      try {
        const choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') { deferredPrompt = null; dismiss(); return; }
      } catch (e) {}
      deferredPrompt = null;
    }
    steps.textContent = manualSteps();
    steps.classList.remove('hidden');
    sub.textContent = 'Installation manuelle';
    installBtn.textContent = 'Compris';
    installBtn.onclick = dismiss;
  };
  document.getElementById('installClose').onclick = dismiss;
  if (navigator.getInstalledRelatedApps) {
    navigator.getInstalledRelatedApps().then(function(apps) {
      if (apps && apps.length) {
        sub.textContent = 'Déjà installée : ouvre-la depuis ton écran d\u2019accueil';
        installBtn.style.display = 'none';
        banner.style.display = 'block';
      }
    }).catch(function() {});
  }
  setTimeout(function() { banner.style.display = 'block'; }, 800);
})();
</script>
